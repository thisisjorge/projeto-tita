{
  "name": "Projeto Titã",
  "short_name": "Titã",
  "description": "Registro de treinos no dispositivo. Rotinas, progresso e backup.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#060709",
  "theme_color": "#060709",
  "orientation": "portrait-primary",
  "share_target": {
    "action": "/routines",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "json", "accept": ["application/json", ".json"] }] }
  },
  "file_handlers": [
    {
      "action": "/routines",
      "accept": { "application/json": [".json"] }
    }
  ],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
