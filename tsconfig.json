{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "server/**/*.js",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "src/**/*",
    "tests/**/*",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "android", "public"]
}
